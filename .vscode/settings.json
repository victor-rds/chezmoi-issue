{
    "editor.detectIndentation": false,
    "editor.insertSpaces": false,
    "files.associations": {
        "**/*.sh.tmpl": "shellscript",
        "**/*.toml.tmpl": "toml",
        "**/dot_bashrc.tmpl": "shellscript"
    },
    "[shellscript]": {
        "editor.tabSize": 8,
        "files.eol": "\n",
    },
    "[toml]": {
        "editor.tabSize": 2,
    }
}